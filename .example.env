# Application Environment
APP_ENV=local
APP_DEBUG=false

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=madong_saas
DB_USERNAME=root
DB_PASSWORD=root
DB_PREFIX=md_

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0

# Queue Redis Configuration
QUEUE_REDIS_HOST=redis://127.0.0.1:6379
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=null
QUEUE_REDIS_DB=0
QUEUE_REDIS_PREFIX=queue

# Cache Configuration
CACHE_CUSTOM_REDIS_HOST=127.0.0.1
CACHE_CUSTOM_REDIS_PORT=6379
CACHE_CUSTOM_REDIS_PASSWORD=null
CACHE_CUSTOM_REDIS_DB=0
CACHE_CUSTOM_REDIS_PREFIX=cache_custom

# ============================================
# 运行形态开关（三形态共用仓库）
# - standard  标准版形态: APP_TENANT_ENABLED=false（单租户无隔离，等价标准版后端；
#             前端配 madong-single / template/admin）
# - saas      多租户形态: APP_TENANT_ENABLED=true（字段隔离，共享表 tenant_id 区分；
#             前端配 template/admin 租户适配分支或 template/mono 的 apps/admin）
#             进阶：库隔离由 config/tenant.php database_isolation + 租户级 database_mode 控制
# ============================================
APP_TENANT_ENABLED=true            # Tenant mode switch（false=标准版形态 true=多租户形态）
APP_TENANT_AUTO_SELECT_FIRST=true  # Tenant auto select first tenant on login

# Feature Toggles
APP_TASK_ENABLED=false             # Timer switch
CAPTCHA_ENABLED=false              # Captcha switch
CAPTCHA_MODE=session               # Captcha mode redis|session
RECYCLE_BIN_ENABLED=true           # Recycle bin mode switch

# Playground 演示环境开关（true=开启拦截，未配置/false=关闭）
PLAYGROUND_ENABLE=false

# JWT Configuration（签名密钥见文件末尾的 JWT_SECRET）
JWT_ALGO=HS256
JWT_ACCESS_TTL=7200
JWT_REFRESH_TTL=604800
JWT_LOGIN_MODE=multi

# Runtime
# 事件循环：留空使用同步模式；仅当已安装 swow 扩展时才启用 Swow 协程驱动
APP_EVENT_LOOP=

# Other Configuration

# JWT Signing Secret
# 安装向导会自动生成随机密钥并写入 .env；禁止提交真实密钥或使用固定示例值。
# 存量部署升级后执行 `php webman jwt:secret`（加 --force 可强制轮换）。
JWT_SECRET=
