<?php
/**
 * {{pluginKey}} 插件路由配置
 * 使用 Swagger 注解自动生成路由
 */

use Webman\Route;
use WebmanTech\Swagger\Swagger;
use OpenApi\Annotations as OA;

Route::group('/api', function () {
    Swagger::create()->registerRoute([
        'route_prefix'   => '/{{kebabPluginKey}}/openapi',
        'register_route' => true,
        'openapi_doc'    => [
            'scan_path' => [
                base_path('plugin/{{pluginKey}}/app/api'),
            ],
            'modify'    => function (OA\OpenApi $openapi) {
                $openapi->info->title   = '{{pluginTitle}} API';
                $openapi->info->version = '{{pluginVersion}}';
                $openapi->servers       = [
                    new OA\Server(['url' => '/api', 'description' => request()->host()]),
                ];
                if (!$openapi->components instanceof OA\Components) {
                    $openapi->components = new OA\Components([]);
                }
                $openapi->components->securitySchemes = [
                    new OA\SecurityScheme([
                        'securityScheme' => 'api_key',
                        'type'           => 'apiKey',
                        'name'           => config('madong.jwt.app.token_name', 'Authorization'),
                        'in'             => 'header',
                    ]),
                ];
            },
        ],
    ]);
});

Route::group('/adminapi', function () {
    Swagger::create()->registerRoute([
        'route_prefix'   => '/{{kebabPluginKey}}/openapi',
        'register_route' => true,
        'openapi_doc'    => [
            'scan_path' => [
                base_path('plugin/{{pluginKey}}/app/adminapi'),
            ],
            'modify'    => function (OA\OpenApi $openapi) {
                $openapi->info->title   = '{{pluginTitle}} API';
                $openapi->info->version = '{{pluginVersion}}';
                $openapi->servers       = [
                    new OA\Server(['url' => '/adminapi', 'description' => request()->host()]),
                ];
                if (!$openapi->components instanceof OA\Components) {
                    $openapi->components = new OA\Components([]);
                }
                $openapi->components->securitySchemes = [
                    new OA\SecurityScheme([
                        'securityScheme' => 'api_key',
                        'type'           => 'apiKey',
                        'name'           => config('madong.jwt.app.token_name', 'Authorization'),
                        'in'             => 'header',
                    ]),
                ];
            },
        ],
    ]);
});
