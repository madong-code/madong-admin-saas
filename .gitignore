!public/favicon.ico
!public/logo.png
!public/upload/logo.png

# 忽略 plugin目录下除了example,demo除外
plugin/*
!plugin/example/
!plugin/demo/

# 忽略tests目录下除了之外的内容
tests/*
!tests/.gitkeep
