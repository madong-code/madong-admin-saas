/runtime
/storage
/.idea
/.vscode
/vendor
*.log
.env
/tests/tmp
/tests/.phpunit.result.cache
install.lock
.rnd


# 忽略运行产生的日志文件
*.err
*.out

# 忽略 public目录下除了install,favicon.ico,logo.png之外的内容
public/*
!public/install/
!public/favicon.ico
!public/logo.png
!public/upload/logo.png

# 插件代码为安装产物，源码统一由插件包管理，不纳入本仓库追踪
plugin/*

# 忽略 tests 目录下的临时产物，保留回归用例与脚手架
tests/*
!tests/.gitkeep
!tests/Bootstrap.php
!tests/Support/
!tests/Support/TestJwtToken.php
!tests/Support/ConfigInjector.php
!tests/saas/
!tests/saas/SecurityExportPathTest.php
!tests/saas/SecurityJwtSecretTest.php
!tests/saas/SecurityPlatformAuthTest.php
!tests/saas/InstallConfigResolverTest.php
!tests/integration/
!tests/integration/SecurityConfigTest.php
!tests/integration/InstallCommandTenantTest.php
